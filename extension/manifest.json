{
  "manifest_version": 3,
  "name": "Умные группы вкладок (Jev)",
  "version": "0.1.0",
  "description": "Раскладывает вкладки по группам — Работа, Учёба, Покупки, Развлечения, Новости — и предлагает закрыть лишние. Решает модель Jev.",
  "permissions": ["tabs", "tabGroups", "storage", "clipboardRead"],
  "host_permissions": [
    "https://api.typesafe.ai/*",
    "https://openrouter.ai/*",
    "https://nano-gpt.com/*",
    "https://inference.do-ai.run/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Умные группы вкладок",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_page": "options.html"
}
